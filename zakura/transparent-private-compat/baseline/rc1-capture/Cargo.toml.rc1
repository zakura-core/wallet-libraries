# Captures an interrupted wallet with the release Vizor consumes today
# (zakura-pir-transparent 0.0.1-rc1 and the published wallet crates). Kept
# outside wallet-libraries: that release depends on wallet-pir-owned packages,
# which no wallet-libraries workspace or lockfile may resolve.
[package]
name = "rc1-capture"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
base-recovery = { package = "zakura-pir-transparent", version = "=0.0.1-rc1", features = ["sqlite", "testing"] }
base-sqlite = { package = "zakura-client-sqlite", version = "=0.1.0-rc9", features = ["orchard", "transparent-inputs", "test-dependencies", "unstable"] }
base-backend = { package = "zakura-client-backend", version = "=0.1.0-rc9", features = ["orchard", "test-dependencies"] }
transparent = { package = "zakura-transparent", version = "3.0.0" }
zcash_primitives = { package = "zakura-primitives", version = "3.0.0" }
zcash_protocol = { package = "zakura-protocol", version = "3.0.0", features = ["local-consensus"] }
rusqlite = { version = "0.37", features = ["bundled"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
hex = "0.4"
tempfile = "3"
axum = "0.7"
tokio = { version = "1", features = ["rt-multi-thread", "net"] }
reqwest = { version = "0.12", default-features = false, features = ["blocking"] }
rand_chacha = "0.3"
uuid = "1"

[profile.dev.package."*"]
opt-level = 3

[workspace]
